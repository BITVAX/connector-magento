<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="connector.view_partner_connector_form" />
        <field name="arch" type="xml">
            <field name="lang" position="after">
                <field name="birthday" />
            </field>
            <field name="street" position="before">
                <field name="company" placeholder="Company" />
            </field>
            <page name="connector" position="attributes">
                <attribute name="invisible">0</attribute>
            </page>
            <page name="connector" position="inside">
                <group string="Magento Bindings">
                    <field name="magento_bind_ids" colspan="2" nolabel="1" />
                </group>
                <group string="Magento Address Bindings">
                    <field name="magento_address_bind_ids" colspan="2" nolabel="1" />
                </group>
            </page>
        </field>
    </record>

    <record id="view_magento_res_partner_form" model="ir.ui.view">
        <field name="name">magento.res.partner.form</field>
        <field name="model">magento.res.partner</field>
        <field name="arch" type="xml">
            <form string="Magento Partner" create="false" delete="false">
                <header>
                    <button
                        name="sync_from_magento"
                        string="From Magento"
                        type="object"
                        class="oe_highlight"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="odoo_id" />
                        <h1>
                            <field name="odoo_id" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group string="Magento">
                            <field name="external_id" string="Magento ID" />
                            <field name="backend_id" />
                            <field name="website_id" />
                            <field name="group_id" />
                            <field name="created_at" />
                            <field name="updated_at" />
                            <field name="sync_date" />
                        </group>
                        <group string="Customer">
                            <field name="emailid" />
                            <field name="phone" readonly="1" />
                            <field name="taxvat" />
                            <field name="newsletter" />
                            <field name="guest_customer" />
                            <field name="consider_as_company" />
                        </group>
                    </group>
                    <notebook>
                        <page name="addresses" string="Addresses">
                            <field name="child_ids" readonly="1">
                                <list>
                                    <field name="name" />
                                    <field name="type" />
                                    <field name="street" />
                                    <field name="zip" />
                                    <field name="city" />
                                    <field name="country_id" />
                                    <field name="phone" optional="hide" />
                                </list>
                            </field>
                        </page>
                        <page name="data" string="JSON Data" groups="base.group_no_one">
                            <field name="data_str" nolabel="1" colspan="4" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_magento_res_partner_tree" model="ir.ui.view">
        <field name="name">magento.res.partner.list</field>
        <field name="model">magento.res.partner</field>
        <field name="arch" type="xml">
            <list string="Magento Partner" create="false" delete="false">
                <field name="name" />
                <field name="emailid" />
                <field name="external_id" string="Magento ID" />
                <field name="group_id" />
                <field name="website_id" />
                <field name="backend_id" optional="hide" />
                <field name="taxvat" optional="hide" />
                <field name="guest_customer" optional="hide" />
                <field name="updated_at" optional="show" />
                <field name="sync_date" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_magento_res_partner_search" model="ir.ui.view">
        <field name="name">magento.res.partner.search</field>
        <field name="model">magento.res.partner</field>
        <field name="arch" type="xml">
            <search string="Magento Partner">
                <field name="name" />
                <field name="emailid" />
                <field name="external_id" string="Magento ID" />
                <field name="group_id" />
                <field name="website_id" />
                <field name="backend_id" />
                <separator />
                <filter
                    name="guest"
                    string="Guest Customers"
                    domain="[('guest_customer', '=', True)]"
                />
                <filter
                    name="newsletter"
                    string="Newsletter"
                    domain="[('newsletter', '=', True)]"
                />
                <filter
                    name="company"
                    string="Considered as Company"
                    domain="[('consider_as_company', '=', True)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_by_website"
                        string="Website"
                        context="{'group_by': 'website_id'}"
                    />
                    <filter
                        name="group_by_group"
                        string="Customer Group"
                        context="{'group_by': 'group_id'}"
                    />
                    <filter
                        name="group_by_backend"
                        string="Backend"
                        context="{'group_by': 'backend_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_magento_res_partner" model="ir.actions.act_window">
        <field name="name">Magento Partners</field>
        <field name="res_model">magento.res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_magento_res_partner_search" />
    </record>

    <record id="view_magento_address_form" model="ir.ui.view">
        <field name="name">magento.address.form</field>
        <field name="model">magento.address</field>
        <field name="arch" type="xml">
            <form string="Magento Address" create="false" delete="false">
                <group>
                    <field name="website_id" />
                    <field name="backend_id" />
                    <field name="magento_partner_id" />
                    <field name="external_id" />
                    <field name="created_at" />
                    <field name="updated_at" />
                    <field name="is_default_billing" />
                    <field name="is_default_shipping" />
                </group>
            </form>
        </field>
    </record>

    <record id="view_magento_address_tree" model="ir.ui.view">
        <field name="name">magento.address.list</field>
        <field name="model">magento.address</field>
        <field name="arch" type="xml">
            <list string="Magento Address" create="false" delete="false">
                <field name="backend_id" />
                <field name="website_id" />
            </list>
        </field>
    </record>

    <record id="view_partner_category_form" model="ir.ui.view">
        <field name="name">res.partner.category.form</field>
        <field name="model">res.partner.category</field>
        <field name="inherit_id" ref="base.view_partner_category_form" />
        <field name="arch" type="xml">
            <field name="parent_id" position="after">
                <field name="magento_bind_ids" colspan="2">
                    <form string="Magento">
                        <field name="backend_id" />
                        <field name="external_id" />
                    </form>
                    <list string="Magento">
                        <field name="backend_id" />
                    </list>
                </field>
            </field>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_product_category_public_form" model="ir.ui.view">
        <field name="name">product.category.public.form</field>
        <field name="model">product.category.public</field>
        <!--
                <field name="groups_id"
                       eval="[(4, ref('connector.group_connector_manager'))]"/>
        -->

        <field name="arch" type="xml">
            <form string="Magento Product Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            type="object"
                            name="action_view_products"
                            class="oe_stat_button"
                            icon="fa-pencil-square-o"
                        >
                            <field
                                name="product_count"
                                widget="statinfo"
                                string="Products"
                            />
                        </button>
                    </div>
                    <group>
                        <field name="name" />
                        <field name="description" />
                        <field name="sequence" />
                        <field name="parent_id" />
                        <field name="child_ids" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_product_category_public_tree" model="ir.ui.view">
        <field name="name">product.category.public.list</field>
        <field name="model">product.category.public</field>
        <field name="arch" type="xml">
            <list string="Product Category Public">
                <field name="name" />
                <field name="parent_id" />
                <field name="product_count" />
            </list>
        </field>
    </record>
    <record id="view_magento_product_category_tree" model="ir.ui.view">
        <field name="name">magento.product.category.list</field>
        <field name="model">magento.product.category</field>
        <field name="arch" type="xml">
            <list string="Magento Product Category">
                <field name="name" />
                <field name="parent_id" />
                <field name="backend_id" />
                <field name="product_count" />
            </list>
        </field>
    </record>

    <record id="view_product_category_public_search" model="ir.ui.view">
        <field name="name">product.category.public.search</field>
        <field name="model">product.category.public</field>
        <field name="arch" type="xml">
            <search string="Search Product Categories">
                <field name="name" filter_domain="[('name','ilike',self)]" />
                <field
                    name="description"
                    filter_domain="[('description','ilike',self)]"
                />
                <field name="parent_id" />

                <filter
                    string="Root Categories"
                    name="root_categories"
                    domain="[('parent_id','=',False)]"
                />
                <filter
                    string="Has Children"
                    name="has_children"
                    domain="[('child_ids','!=',False)]"
                />
                <filter
                    string="Has Products"
                    name="has_products"
                    domain="[('product_count','>',0)]"
                />

                <separator />
                <filter string="Active" name="active" domain="[('active','=',True)]" />
                <filter
                    string="Inactive"
                    name="inactive"
                    domain="[('active','=',False)]"
                />

                <group expand="0" string="Group By">
                    <filter
                        string="Parent Category"
                        name="group_parent"
                        context="{'group_by':'parent_id'}"
                    />
                    <filter
                        string="Product Count"
                        name="group_product_count"
                        context="{'group_by':'product_count'}"
                    />
                </group>

                <searchpanel>
                    <field
                        name="parent_id"
                        icon="fa-folder"
                        select="multi"
                        enable_counters="1"
                    />
                </searchpanel>
            </search>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="action_magento_backend" model="ir.actions.act_window">
        <field name="name">Magento Backends</field>
        <field name="res_model">magento.backend</field>
        <!--        <field name="view_type">form</field>-->
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_magento_backend_tree" />
    </record>
    <record id="action_magento_store" model="ir.actions.act_window">
        <field name="name">Magento Stores</field>
        <field name="res_model">magento.store</field>
        <!--        <field name="view_type">form</field>-->
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_magento_store_tree" />
    </record>
    <record id="action_magento_website" model="ir.actions.act_window">
        <field name="name">Magento Websites</field>
        <field name="res_model">magento.website</field>
        <!--        <field name="view_type">form</field>-->
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_magento_website_tree" />
    </record>

    <record id="action_magento_storeview" model="ir.actions.act_window">
        <field name="name">Magento Storeviews</field>
        <field name="res_model">magento.storeview</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_magento_storeview_tree" />
    </record>

    <record id="action_magento_account_tax" model="ir.actions.act_window">
        <field name="name">Magento Account Tax</field>
        <field name="res_model">magento.account.tax</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_product_category_public" model="ir.actions.act_window">
        <field name="name">Product Categories Public</field>
        <field name="res_model">product.category.public</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_magento_attribute_set" model="ir.actions.act_window">
        <field name="name">Magento Attribute Sets</field>
        <field name="res_model">magento.product.attribute.set</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_magento_attribute_set_list" />
    </record>

    <record model="ir.actions.act_window" id="action_magento_product_product">
        <field name="name">Magento Product</field>
        <field name="res_model">magento.product.product</field>
        <field name="view_mode">list,form</field>
    </record>
    <record model="ir.actions.act_window" id="action_magento_product_template">
        <field name="name">Magento Product Template</field>
        <field name="res_model">magento.product.template</field>
        <field name="view_mode">list,form</field>
    </record>
    <record model="ir.actions.act_window" id="action_magento_product_category">
        <field name="name">Magento Product Category</field>
        <field name="res_model">magento.product.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record
        model="ir.actions.act_window"
        id="action_magento_product_template_attribute_line"
    >
        <field name="name">Magento Product Template Attribute Line</field>
        <field name="res_model">magento.product.template.attribute.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_magento_template_attribute_line_list" />
    </record>
    <!-- Action for magento.product.attribute -->
    <record id="action_magento_product_attribute" model="ir.actions.act_window">
        <field name="name">Magento Product Attributes</field>
        <field name="res_model">magento.product.attribute</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Actions of the bindings that had none: every binding has its entry
         in the Bindings menu (the store bindings are configuration, in the
         Magento menu). -->

    <record id="action_magento_product_attribute_value" model="ir.actions.act_window">
        <field name="name">Magento Attribute Values</field>
        <field name="res_model">magento.product.attribute.value</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_magento_product_attribute_value_list" />
        <field
            name="search_view_id"
            ref="view_magento_product_attribute_value_search"
        />
    </record>

    <record id="action_magento_res_partner_category" model="ir.actions.act_window">
        <field name="name">Magento Customer Groups</field>
        <field name="res_model">magento.res.partner.category</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_magento_partner_category_list" />
    </record>

    <record id="action_magento_address" model="ir.actions.act_window">
        <field name="name">Magento Addresses</field>
        <field name="res_model">magento.address</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_magento_address_bindings_list" />
    </record>

    <record id="action_magento_sale_order" model="ir.actions.act_window">
        <field name="name">Magento Sale Orders</field>
        <field name="res_model">magento.sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_magento_sale_order_bindings_list" />
    </record>

    <record id="action_magento_sale_order_line" model="ir.actions.act_window">
        <field name="name">Magento Sale Order Lines</field>
        <field name="res_model">magento.sale.order.line</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_magento_sale_order_line_list" />
    </record>

    <record id="action_magento_stock_picking" model="ir.actions.act_window">
        <field name="name">Magento Deliveries</field>
        <field name="res_model">magento.stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_magento_stock_picking_bindings_list" />
    </record>

    <record id="action_magento_account_invoice" model="ir.actions.act_window">
        <field name="name">Magento Invoices</field>
        <field name="res_model">magento.account.invoice</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_magento_account_invoice_bindings_list" />
    </record>

    <!-- Connectors > Magento: the configuration -->

    <menuitem
        id="menu_magento_root"
        parent="connector.menu_connector_root"
        name="Magento"
        sequence="10"
        groups="connector.group_connector_manager"
    />

    <menuitem
        id="menu_magento_backend"
        name="Backends"
        parent="menu_magento_root"
        action="action_magento_backend"
    />

    <menuitem
        id="menu_magento_website"
        name="Websites"
        parent="menu_magento_root"
        sequence="20"
        action="action_magento_website"
    />

    <menuitem
        id="menu_magento_store"
        name="Stores"
        parent="menu_magento_root"
        sequence="30"
        action="action_magento_store"
    />

    <menuitem
        id="menu_magento_storeview"
        name="Storeviews"
        parent="menu_magento_root"
        sequence="40"
        action="action_magento_storeview"
    />

    <menuitem
        id="menu_magento_category"
        name="Public Categories"
        parent="menu_magento_root"
        sequence="50"
        action="action_product_category_public"
    />

    <menuitem
        id="menu_product_product_categories"
        name="Public Categories"
        parent="stock.menu_product_in_config_stock"
        sequence="95"
        action="action_product_category_public"
    />

    <!-- Connectors > Bindings: every link between an Odoo record and its
         Magento counterpart, to review, fix or delete them. Deleting a binding
         only removes the link: the Odoo record stays and nothing is sent to
         Magento. -->

    <menuitem
        id="menu_magento_bindings"
        name="Bindings"
        parent="connector.menu_connector_root"
        sequence="11"
        groups="connector.group_connector_manager"
    />

    <menuitem
        id="menu_magento_bindings_catalog"
        name="Catalog"
        parent="menu_magento_bindings"
        sequence="10"
    />
    <menuitem
        id="menu_magento_product_product"
        name="Products"
        parent="menu_magento_bindings_catalog"
        sequence="10"
        action="action_magento_product_product"
    />
    <menuitem
        id="menu_magento_product_template"
        name="Configurable Products"
        parent="menu_magento_bindings_catalog"
        sequence="20"
        action="action_magento_product_template"
    />
    <menuitem
        id="menu_magento_product_template_attribute_line"
        name="Attribute Lines"
        parent="menu_magento_bindings_catalog"
        sequence="30"
        action="action_magento_product_template_attribute_line"
    />
    <menuitem
        id="menu_magento_product_attribute"
        name="Attributes"
        parent="menu_magento_bindings_catalog"
        sequence="40"
        action="action_magento_product_attribute"
    />
    <menuitem
        id="menu_magento_product_attribute_value"
        name="Attribute Values"
        parent="menu_magento_bindings_catalog"
        sequence="50"
        action="action_magento_product_attribute_value"
    />
    <menuitem
        id="menu_magento_attribute_set"
        name="Attribute Sets"
        parent="menu_magento_bindings_catalog"
        sequence="60"
        action="action_magento_attribute_set"
    />
    <menuitem
        id="menu_magento_product_category"
        name="Categories"
        parent="menu_magento_bindings_catalog"
        sequence="70"
        action="action_magento_product_category"
    />

    <menuitem
        id="menu_magento_bindings_customers"
        name="Customers"
        parent="menu_magento_bindings"
        sequence="20"
    />
    <menuitem
        id="menu_magento_res_partner"
        name="Contacts"
        parent="menu_magento_bindings_customers"
        sequence="10"
        action="action_magento_res_partner"
    />
    <menuitem
        id="menu_magento_address"
        name="Addresses"
        parent="menu_magento_bindings_customers"
        sequence="20"
        action="action_magento_address"
    />
    <menuitem
        id="menu_magento_res_partner_category"
        name="Customer Groups"
        parent="menu_magento_bindings_customers"
        sequence="30"
        action="action_magento_res_partner_category"
    />

    <menuitem
        id="menu_magento_bindings_sales"
        name="Sales"
        parent="menu_magento_bindings"
        sequence="30"
    />
    <menuitem
        id="menu_magento_sale_order"
        name="Sale Orders"
        parent="menu_magento_bindings_sales"
        sequence="10"
        action="action_magento_sale_order"
    />
    <menuitem
        id="menu_magento_sale_order_line"
        name="Sale Order Lines"
        parent="menu_magento_bindings_sales"
        sequence="20"
        action="action_magento_sale_order_line"
    />
    <menuitem
        id="menu_magento_stock_picking"
        name="Deliveries"
        parent="menu_magento_bindings_sales"
        sequence="30"
        action="action_magento_stock_picking"
    />
    <menuitem
        id="menu_magento_account_invoice"
        name="Invoices"
        parent="menu_magento_bindings_sales"
        sequence="40"
        action="action_magento_account_invoice"
    />
    <menuitem
        id="menu_magento_account_tax"
        name="Tax Classes"
        parent="menu_magento_bindings_sales"
        sequence="50"
        action="action_magento_account_tax"
    />
</odoo>

        <field name="model">magento.stock.picking</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="odoo_id" />
                <field name="magento_order_id" />
                <field name="picking_method" />
                <field name="external_id" />
                <field name="sync_date" optional="show" />
                <field name="backend_id" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_magento_account_invoice_bindings_list" model="ir.ui.view">
        <field name="name">magento.account.invoice.list.bindings</field>
        <field name="model">magento.account.invoice</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="odoo_id" />
                <field name="magento_order_id" />
                <field name="external_id" />
                <field name="sync_date" optional="show" />
                <field name="backend_id" optional="hide" />
            </list>
        </field>
    </record>
</odoo>
